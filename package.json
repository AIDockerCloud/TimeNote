{
  "name": "timenote",
  "version": "1.0.10",
  "private": true,
  "description": "Obsidian 插件：基于周期日记的时间轴与全周期日历视图",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "check": "npm run typecheck && python3 scripts/pcmp_index.py --check",
    "bump": "node scripts/bump-version.mjs",
    "pack": "node scripts/pack.mjs",
    "dist": "npm run build && npm run pack",
    "test:timeline": "node scripts/dev/test-elastic-timeline.mjs",
    "preview:timeline": "node scripts/dev/preview-timeline.mjs",
    "preview:target": "node scripts/dev/preview-target-design.mjs",
    "preview:real": "node scripts/dev/preview-real-dom.mjs && node scripts/dev/preview-real-dom.mjs --dark",
    "preview:points": "node scripts/dev/preview-point-lines.mjs",
    "test:drag": "node scripts/dev/test-drag-writeback.mjs",
    "test:visual": "node scripts/dev/test-visual-regression.mjs",
    "test:tints": "node scripts/dev/test-block-tints.mjs",
    "test:open": "node scripts/dev/test-open-daily-note.mjs",
    "test:points": "node scripts/dev/test-point-lines.mjs",
    "test:section": "node scripts/dev/test-quick-add-section.mjs",
    "test:render": "node scripts/dev/test-render-race.mjs",
    "test:cross": "node scripts/dev/test-cross-day.mjs",
    "preview:cross": "node scripts/dev/preview-cross-day.mjs",
    "test": "npm run test:timeline && npm run test:drag && npm run test:visual && npm run test:tints && npm run test:open && npm run test:points && npm run test:section && npm run test:render && npm run test:cross"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "daily-notes",
    "calendar",
    "timeline"
  ],
  "author": "AIDockerCloud",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  }
}
