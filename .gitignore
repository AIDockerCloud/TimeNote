# Obsidian 插件运行时数据（由 Obsidian 生成，不入库）
data.json
.obsidian/

# 依赖与构建产物
node_modules/
*.js.map

# 发布包（npm run pack / dist → timenote-<version>.zip，由 Release 重新生成，不入库）
dist/
# 注意：main.js 是 esbuild 产物，但必须入库以支持零构建安装，故不忽略
# core/index.mjs 只给开发脚本 import 用（npm run build:core 生成），不入库
core/index.mjs
# sources/index.mjs 同理（npm run build:sources 生成），不入库
sources/index.mjs
# ui/index.mjs 同理（npm run build:ui 生成），不入库
ui/index.mjs
# hosts/index.mjs 同理（npm run build:hosts 生成），不入库
hosts/index.mjs
# apps/index.mjs 同理（npm run build:apps 生成），不入库
apps/index.mjs

# 桌面环境回收站目录（非项目文件，勿提交）
.Trash-*/

# PCMP 派生索引：Markdown 才是权威，缓存可随时删除重建
ai/.cache/

# 开发脚本的生成产物（预览 HTML 等，可随时用 npm run preview:timeline 重建）
scripts/dev/out/

# AI 协作本地记忆与工作数据（不入库）
.workbuddy/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
